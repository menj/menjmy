{
    "root": true,
    "env": {
        "browser": true,
        "es2021": true
    },
    "extends": [
        "eslint:recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "script"
    },
    "ignorePatterns": [
        "assets/js/vendor/**/*.js"
    ],
    "globals": {
        "bookWP": "readonly",
        "imagesLoaded": "readonly",
        "InfiniteScroll": "readonly",
        "Masonry": "readonly",
        "wp": "readonly"
    },
    "rules": {
        "no-console": "warn",
        "no-unused-vars": [
            "error",
            {
                "args": "after-used",
                "vars": "all"
            }
        ]
    }
}
